# Neon — copy to `.env.local` via `neon checkout` / `neon env pull`. Do not commit real values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_DATA_API_URL=
# Optional. Next rewrites /gateway/* here. Defaults to http://127.0.0.1:8787.
# WORKER_URL=http://127.0.0.1:8787
# Public app origin used in password-reset links and Worker CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
